# Copy to .env.local for local development. On Netlify, set these under
# Site configuration → Environment variables.

# Supabase → Connect → "Transaction pooler" connection string (port 6543),
# with [YOUR-PASSWORD] replaced by your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Long random string used to sign login cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# First manager login, created only when the database has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Timezone that decides which work day a ticket counts toward.
APP_TIMEZONE=America/New_York
